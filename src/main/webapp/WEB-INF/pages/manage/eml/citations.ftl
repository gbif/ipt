    <#setting number_format="#####.##">
    <#include "/WEB-INF/pages/inc/header.ftl">
    <link rel="stylesheet" href="${baseURL}/styles/smaller-inputs.css">
    <link rel="stylesheet" href="${baseURL}/styles/contacts.css">
    <#-- runs on DOMContentLoaded, after Bootstrap and html5sortable from the footer -->
    <script src="${baseURL}/js/eml-cards.js"></script>
    <title><@s.text name='manage.metadata.citations.title'/></title>
    <script>
        $(document).ready(function () {
            $('#metadata-section').change(function () {
                var metadataSection = $('#metadata-section').find(':selected').val()
                $(location).attr('href', 'metadata-' + metadataSection + '.do?r=${resource.shortname!r!}');
            });

            // auto-generation shows the citation the IPT will publish; switching it off empties the field for the
            // user's own text
            var $switch = $("#citation-auto");
            var $citation = $("#eml\\.citation\\.citation");
            $switch.on("change", function () {
                var on = $switch.prop("checked");
                $("#cit").val(on ? "true" : "false");
                $citation.val(on ? $citation.attr("data-generated") : "").prop("readonly", on);
                if (!on) {
                    $citation.trigger("focus");
                }
            });

            // scroll to the first error, if any
            var invalid = $(".is-invalid").first();
            if (invalid.length) {
                $('body, html').animate({scrollTop: invalid.offset().top - 120});
            }

            makeSureResourceParameterIsPresentInURL('${resource.shortname}');
        });
    </script>
    <#assign currentMetadataPage = "citations"/>
    <#assign currentMenu="manage"/>
    <#include "/WEB-INF/pages/macros/icon.ftl"/>
    <#assign materialHelpIcons = true/>
    <link rel="stylesheet" href="${baseURL}/styles/overview.css">
    <link rel="stylesheet" href="${baseURL}/styles/eml.css">
    <#include "/WEB-INF/pages/inc/menu.ftl">
    <#include "/WEB-INF/pages/macros/forms.ftl"/>
    <#include "eml_cards.ftl"/>

    <#-- the citation the IPT generates for the next version -->
    <#attempt>
        <#assign generatedCitation = action.resource.generateResourceCitation(resource.getNextVersion().toPlainString()?string, cfg.getResourceVersionUri(resource.getShortname(), resource.getNextVersion().toPlainString()?string))!""/>
    <#recover>
        <#assign generatedCitation = ""/>
    </#attempt>
    <#assign citationAuto = resource.isCitationAutoGenerated()/>

    <#macro referenceCard index=-1 item={}>
        <#local base = (index >= 0)?then("eml.bibliographicCitationSet.bibliographicCitations[" + index?c + "]", "TPL")/>
        <div class="ms-step" data-card>
            <@cardHead titleKey="manage.metadata.citations.reference" index=index/>
            <div class="row g-3">
                <div class="col-12">
                    <@text name="${base}.citation" value=(item.citation)!"" i18nkey="eml.bibliographicCitationSet.bibliographicCitations.citation" help="i18n" rows=3 requiredField=true/>
                </div>
                <div class="col-12">
                    <@input name="${base}.identifier" value=(item.identifier)!"" i18nkey="eml.bibliographicCitationSet.bibliographicCitations.identifier" help="i18n"/>
                </div>
            </div>
        </div>
    </#macro>

    <#macro formatCard index=-1 item={}>
        <#local base = (index >= 0)?then("eml.physicalData[" + index?c + "]", "TPL")/>
        <div class="ms-step" data-card>
            <@cardHead titleKey="manage.metadata.physical.format" index=index/>
            <div class="row g-3">
                <div class="col-lg-6">
                    <@input name="${base}.name" value=(item.name)!"" i18nkey="eml.physicalData.name" requiredField=true/>
                </div>
                <div class="col-lg-6">
                    <@input name="${base}.charset" value=(item.charset)!"" i18nkey="eml.physicalData.charset" help="i18n" requiredField=true/>
                </div>
                <div class="col-12">
                    <@input name="${base}.distributionUrl" value=(item.distributionUrl)!"" i18nkey="eml.physicalData.distributionUrl" help="i18n" requiredField=true type="url"/>
                </div>
                <div class="col-lg-6">
                    <@input name="${base}.format" value=(item.format)!"" i18nkey="eml.physicalData.format" help="i18n" requiredField=true/>
                </div>
                <div class="col-lg-6">
                    <@input name="${base}.formatVersion" value=(item.formatVersion)!"" i18nkey="eml.physicalData.formatVersion" help="i18n"/>
                </div>
            </div>
        </div>
    </#macro>

    <#macro altIdCard index=-1 value="">
        <#local name = (index >= 0)?then("eml.alternateIdentifiers[" + index?c + "]", "TPL")/>
        <div class="ms-step ec-inline" data-card>
            <@cardHead titleKey="" inline=true>
                <label class="visually-hidden" for="${name}"><@s.text name="eml.alternateIdentifier"/></label>
                <input class="form-control" type="text" id="${name}" name="${name}" value="${value}"/>
            </@cardHead>
            <#if (index >= 0)>
                <@s.fielderror id="field-error-${name}" cssClass="invalid-feedback list-unstyled field-error d-block my-1" fieldName="${name}"/>
            </#if>
        </div>
    </#macro>

    <div class="container px-0">
        <#include "/WEB-INF/pages/inc/action_alerts.ftl">
    </div>

    <form class="needs-validation track-unsaved" action="metadata-${section}.do" method="post" novalidate>
        <#include "eml_heading.ftl"/>

        <#include "metadata_section_select.ftl"/>

        <div class="container-fluid bg-body">
            <div class="container bd-layout main-content-container">
                <main class="bd-main">
                    <div class="bd-toc mt-4 mb-5 ps-3 mb-lg-5 text-muted">
                        <#include "eml_sidebar.ftl"/>
                    </div>

                    <div class="bd-content">
                        <div class="my-md-3 p-3" id="s-citation" data-toc="${action.getText('eml.citation.citation')}">
                            <@textinline name="eml.citation.citation" help="i18n"/>
                            <p class="party-intro"><@s.text name="manage.metadata.citations.intro"/></p>

                            <div class="ov-banner info compact mb-3">
                                <span class="ov-ic"><@icon name="info"/></span>
                                <div class="ov-grow"><p class="ov-text my-0"><@s.text name="manage.metadata.citations.warning"/></p></div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <#-- the heading names the field; the label stays for screen readers -->
                                        <label class="visually-hidden" for="eml.citation.citation"><@s.text name="eml.citation.citation"/></label>
                                        <#-- the same setting as on the Contacts page -->
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="citation-auto" <#if citationAuto>checked</#if>/>
                                            <label class="form-check-label small" for="citation-auto"><@s.text name="eml.party.citation.auto"/></label>
                                        </div>
                                        <input id="cit" name="resource.citationAutoGenerated" type="hidden" value="${citationAuto?c}"/>
                                    </div>
                                    <textarea class="form-control" rows="3" id="eml.citation.citation" name="eml.citation.citation"
                                              data-generated="${generatedCitation}" <#if citationAuto>readonly</#if>><#if citationAuto>${generatedCitation}<#else>${(eml.citation.citation)!}</#if></textarea>
                                    <@s.fielderror id="field-error-eml.citation.citation" cssClass="invalid-feedback list-unstyled field-error my-1" fieldName="eml.citation.citation"/>
                                </div>
                                <div class="col-12">
                                    <#attempt>
                                        <#if resource.doi?? && doiReservedOrAssigned>
                                            <@input name="eml.citation.identifier" value=(resource.doi.getUrl())! help="i18n" disabled=true/>
                                        <#else>
                                            <@input name="eml.citation.identifier" value=(resource.citation.identifier)! help="i18n"/>
                                        </#if>
                                    <#recover>
                                    </#attempt>
                                </div>
                            </div>
                        </div>

                        <div class="my-3 p-3" id="s-bibliography" data-toc="${action.getText('manage.metadata.citations.bibliography')}">
                            <@textinline name="manage.metadata.citations.bibliography"/>
                            <p class="party-intro"><@s.text name="manage.metadata.citations.bibliography.help"/> <@s.text name="manage.metadata.citations.warning.doNotNumber"/></p>

                            <@cardList base="eml.bibliographicCitationSet.bibliographicCitations" titleKey="manage.metadata.citations.reference"
                                       addKey="manage.metadata.citations.addReference" emptyKey="manage.metadata.citations.noReference"; part>
                                <#if part == "cards">
                                    <#list eml.bibliographicCitationSet.bibliographicCitations as item>
                                        <@referenceCard index=item?index item=item/>
                                    </#list>
                                <#else>
                                    <@referenceCard/>
                                </#if>
                            </@cardList>
                        </div>

                        <#-- were the External links page (#3319) -->
                        <div class="my-3 p-3" id="s-physical" data-toc="${action.getText('eml.distributionUrl')}">
                            <@textinline name="eml.distributionUrl"/>
                            <p class="party-intro"><@s.text name="manage.metadata.physical.intro"/></p>
                            <label class="visually-hidden" for="eml.distributionUrl"><@s.text name="eml.distributionUrl"/></label>
                            <input class="form-control" type="url" id="eml.distributionUrl" name="eml.distributionUrl" value="${eml.distributionUrl!}" placeholder="https://"/>
                            <@s.fielderror id="field-error-eml.distributionUrl" cssClass="invalid-feedback list-unstyled field-error my-1" fieldName="eml.distributionUrl"/>
                        </div>

                        <div class="my-3 p-3" id="s-other-formats" data-toc="${action.getText('eml.physicalData.other')}">
                            <@textinline name="eml.physicalData.other"/>
                            <p class="party-intro"><@s.text name="eml.physicalData.other.help"/></p>

                            <@cardList base="eml.physicalData" titleKey="manage.metadata.physical.format"
                                       addKey="manage.metadata.physical.addFormat" emptyKey="manage.metadata.physical.noFormat"; part>
                                <#if part == "cards">
                                    <#list eml.physicalData as item>
                                        <@formatCard index=item?index item=item/>
                                    </#list>
                                <#else>
                                    <@formatCard/>
                                </#if>
                            </@cardList>
                        </div>

                        <#-- were on the Additional Metadata page (#3319) -->
                        <div class="my-3 p-3" id="s-alternative-identifiers" data-toc="${action.getText('manage.metadata.alternateIdentifiers.title')}">
                            <@textinline name="manage.metadata.alternateIdentifiers.title" i18nkey="eml.alternateIdentifier" help="i18n"/>
                            <p class="party-intro"><@s.text name="manage.metadata.alternateIdentifiers.title.help"/></p>

                            <@cardList base="eml.alternateIdentifiers" titleKey="manage.metadata.alternateIdentifiers.identifier"
                                       addKey="manage.metadata.alternateIdentifiers.add" emptyKey="manage.metadata.alternateIdentifiers.none"; part>
                                <#if part == "cards">
                                    <#list eml.alternateIdentifiers as item>
                                        <@altIdCard index=item?index value=item!""/>
                                    </#list>
                                <#else>
                                    <@altIdCard/>
                                </#if>
                            </@cardList>
                        </div>

                        <!-- internal parameter -->
                        <input name="r" type="hidden" value="${resource.shortname}" />
                    </div>
                </main>
            </div>
        </div>

        <#include "eml_savebar.ftl"/>
    </form>

    <#include "/WEB-INF/pages/manage/eml/unsaved_changes_modal.ftl">

    <div class="party-toast" id="party-toast" role="status" aria-live="polite"></div>

    <#include "/WEB-INF/pages/inc/footer.ftl">
