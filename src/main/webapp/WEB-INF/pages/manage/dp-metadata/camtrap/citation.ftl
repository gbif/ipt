<#-- @ftlvariable name="" type="org.gbif.ipt.action.manage.CamtrapMetadataAction" -->
    <#include "/WEB-INF/pages/macros/icon.ftl"/>
    <#include "/WEB-INF/pages/inc/header.ftl">
    <title><@s.text name='manage.datapackagemetadata.camtrap.citation.title'/></title>
    <link rel="stylesheet" href="${baseURL}/styles/smaller-inputs.css">
    <link rel="stylesheet" href="${baseURL}/styles/overview.css">
    <link rel="stylesheet" href="${baseURL}/styles/eml.css">
    <#assign currentMenu="manage"/>
    <#assign currentMetadataPage = "citation"/>
    <#assign savebarAction = "camtrap-metadata-citation"/>
    <#assign materialHelpIcons = true/>
    <#include "/WEB-INF/pages/inc/menu.ftl">
    <#include "/WEB-INF/pages/macros/forms.ftl"/>

    <#assign citationAuto = resource.isCitationAutoGenerated()/>
    <#assign nextVersion = resource.getNextVersion().toPlainString()/>
    <#assign autoCitation = (action.resource.generateDataPackageResourceCitation(nextVersion, cfg.getResourceVersionUri(resource.getShortname(), nextVersion)))!""/>

    <div class="container px-0">
        <#include "/WEB-INF/pages/inc/action_alerts.ftl">
    </div>

    <form id="citation-form" class="needs-validation track-unsaved" action="camtrap-metadata-${section}.do" method="post" novalidate>
        <input type="hidden" name="r" value="${resource.shortname}" />

        <#include "metadata_heading.ftl"/>

        <div class="container-fluid bg-body">
            <div class="container bd-layout main-content-container">
                <main class="bd-main">
                    <div class="bd-toc mt-4 mb-5 ps-3 mb-lg-5 text-muted">
                        <#include "metadata_sidebar.ftl"/>
                    </div>

                    <div class="bd-content">
                        <div class="my-md-3 p-3">
                            <div class="ov-banner info" role="status">
                                <@icon name="info" class="ov-ic"/>
                                <div class="ov-grow"><@s.text name="datapackagemetadata.citation.warning"/></div>
                            </div>

                            <div class="d-flex justify-content-end">
                                <div class="form-check form-switch text-smaller mb-1">
                                    <input class="form-check-input" type="checkbox" role="switch" id="citation-auto-switch" data-citation="${autoCitation}" <#if citationAuto>checked</#if>/>
                                    <label class="form-check-label" for="citation-auto-switch"><@s.text name="eml.party.citation.auto"/></label>
                                </div>
                                <input id="cit" name="resource.citationAutoGenerated" type="hidden" value="${citationAuto?c}"/>
                            </div>
                            <@text name="metadata.bibliographicCitation" help="i18n" i18nkey="datapackagemetadata.other.bibliographicCitation" />
                        </div>
                    </div>
                </main>
            </div>
        </div>

        <#include "/WEB-INF/pages/manage/eml/eml_savebar.ftl"/>
    </form>

    <#include "/WEB-INF/pages/manage/eml/unsaved_changes_modal.ftl">

    <#include "/WEB-INF/pages/inc/footer.ftl">

    <script>
        $(document).ready(function () {
            // generated: the citation of the next version, read-only; switched off: empty, to be written by hand
            var $switch = $("#citation-auto-switch");
            var $citation = $("#metadata\\.bibliographicCitation");

            function apply(auto) {
                $("#cit").val(auto ? "true" : "false");
                $citation.prop("readonly", auto);
                if (auto) {
                    $citation.val($switch.attr("data-citation"));
                }
            }

            $switch.on("change", function () {
                var auto = this.checked;
                if (!auto) {
                    $citation.val("");
                }
                apply(auto);
                if (!auto) {
                    $citation.trigger("focus");
                }
            });

            apply($switch.prop("checked"));

            makeSureResourceParameterIsPresentInURL('${resource.shortname}');
        });
    </script>
